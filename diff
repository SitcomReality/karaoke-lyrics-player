// Audio playback and control functions
import { state } from '../state.js';
import { elements } from '../dom.js';
import * as UI from './ui/index.js';
import * as Playlist from './playlist.js';
import * as Lyrics from './lyrics.js';
import * as Storage from './storage.js';
import * as AudioLocator from './audioLocator.js'; // Import AudioLocator for setupInitialAudio fallback

// Store listener function references to properly remove them
let currentLoadedMetadataListener = null;
let currentTimeUpdateListener = null;
let currentEndedListener = null;

export function cleanupOldAudio() {
    if (state.audio) {
        state.audio.pause();

        // Remove specific listeners if they were set
        if (currentLoadedMetadataListener) {
            state.audio.removeEventListener('loadedmetadata', currentLoadedMetadataListener);
            currentLoadedMetadataListener = null;
        }
        if (currentTimeUpdateListener) {
            state.audio.removeEventListener('timeupdate', currentTimeUpdateListener);
            currentTimeUpdateListener = null;
        }
        if (currentEndedListener) {
            state.audio.removeEventListener('ended', currentEndedListener);
            currentEndedListener = null;
        }
        
        // Revoke ObjectURL if it's a blob
        if (state.audio.src && state.audio.src.startsWith('blob:')) {
            URL.revokeObjectURL(state.audio.src);
        }
    }
    state.audio = null;
    state.isPlaying = false;
    state.currentTime = 0;
    state.duration = 0;
    state.audioAnalyser = null; // Also clear the analyser reference
}

export function setupInitialAudio() {
    if (state.audio) { // If audio object already exists (e.g. from a previous load during the session)
        return;
    }

    let audioUrlToTry = state.currentSong?.audioUrl;

    if (audioUrlToTry) {
        console.log("setupInitialAudio: Attempting to load persisted audio URL:", audioUrlToTry);
        const initialAudio = new Audio(audioUrlToTry); // Create a temporary audio element
        
        const tempOnLoadedMetadata = () => {
            initialAudio.removeEventListener('loadedmetadata', tempOnLoadedMetadata);
            initialAudio.removeEventListener('error', tempOnError);

            state.audio = initialAudio; // Assign to global state ONLY if successfully loaded
            setupAudioListeners();      // Then setup persistent listeners
            UI.updateUI();
            console.log("setupInitialAudio: Successfully loaded metadata for persisted audio.");
        };

        const tempOnError = () => {
            initialAudio.removeEventListener('loadedmetadata', tempOnLoadedMetadata);
            initialAudio.removeEventListener('error', tempOnError);

            console.warn("setupInitialAudio: Persisted audioUrl is invalid, clearing:", audioUrlToTry);
            if (audioUrlToTry.startsWith('blob:')) {
                URL.revokeObjectURL(audioUrlToTry);
            }
            if (state.currentSong) state.currentSong.audioUrl = null;
            
            if (state.currentSong && state.currentSong.audioFilename) {
                console.log("setupInitialAudio: Persisted URL failed, attempting AudioLocator for:", state.currentSong.audioFilename);
                AudioLocator.findAndLoadAudio(state.currentSong).finally(() => UI.updateUI());
            } else {
                UI.updateUI();
            }
        };

        initialAudio.addEventListener('loadedmetadata', tempOnLoadedMetadata);
        initialAudio.addEventListener('error', tempOnError);

    } else if (state.currentSong && state.currentSong.audioFilename) {
        console.log("setupInitialAudio: No persisted URL, attempting AudioLocator for:", state.currentSong.audioFilename);
        AudioLocator.findAndLoadAudio(state.currentSong).finally(() => UI.updateUI());
    }
}

export function setupAudioListeners() {
    if (!state.audio) return;

    // Define new listener functions for the current state.audio
    currentLoadedMetadataListener = () => {
        state.duration = state.audio.duration;
        updateTimeDisplay();
        UI.updateProgressUI(); 
    };

    currentTimeUpdateListener = () => {
        if (!state.audio) return; // Safety guard
        state.currentTime = state.audio.currentTime;
        updateTimeDisplay();
        UI.updateProgressUI();
        Lyrics.updateHighlightedLyrics(); 
    };

    currentEndedListener = () => {
        state.isPlaying = false;
        UI.updatePlayerControls(); // Update button based on new state.isPlaying

        state.currentTime = 0; 
        UI.updateProgressUI(); 
        state.currentLineIndex = -1; 
        Lyrics.renderLyrics();

        if (state.currentPlaylistId && state.autoAdvanceEnabled) {
            setTimeout(() => Playlist.playNextSong(), 1500);
        }
    };

    // Add the new listeners
    state.audio.addEventListener('loadedmetadata', currentLoadedMetadataListener);
    state.audio.addEventListener('timeupdate', currentTimeUpdateListener);
    state.audio.addEventListener('ended', currentEndedListener);

    if (elements.volumeSlider) { // ensure elements are loaded
        state.audio.volume = parseFloat(elements.volumeSlider.value);
    } else {
        state.audio.volume = 1; // default if slider not found
    }

    // Set up audio analysis for visualization if Web Audio API is supported
    try {
        if (!state.audio) { // Double-check state.audio, though top guard should suffice
            // This case should ideally not be hit if the top guard `if (!state.audio) return;` is working.
            // If it is hit, it means state.audio became null between the top guard and here, which is unlikely in sync code.
            console.warn("setupAudioListeners: state.audio became null before visualizer setup. Skipping visualizer.");
            state.audioAnalyser = null;
            return;
        }
 
        if (!state.audioContext || state.audioContext.state === 'closed') {
            console.log("setupAudioListeners: Creating or recreating AudioContext.");
            // It's good practice to close an old context if recreating, though JS garbage collection should handle it.
            // However, directly closing might not be necessary if simply reassigning.
            state.audioContext = new (window.AudioContext || window.webkitAudioContext)();
        }
         
        // Resume context if suspended (e.g., due to autoplay policies or page load)
        if (state.audioContext && state.audioContext.state === 'suspended') {
            state.audioContext.resume().catch(e => console.warn("setupAudioListeners: Failed to resume audio context:", e));
        }
 
        // Ensure audioContext is valid and ready before proceeding
        if (state.audioContext && state.audioContext.state === 'running') {
            // MediaElementAudioSourceNode can only be created once per HTMLMediaElement per AudioContext.
            // Since cleanupOldAudio nulls state.audioAnalyser, we assume any old source/analyser chain is gone.
            // A more robust (but complex) approach would be to track source nodes with MediaElements.
            // For now, we rely on state.audio being a fresh element or listeners being correctly managed.
+
            // If state.audio already has a source node in this context, creating another will throw.
            // This check is difficult without tracking nodes externally.
            // We assume that if we are here, `state.audio` is new or needs new connections.
            // `cleanupOldAudio` should have nulled `state.audioAnalyser`, indicating a need for new setup.
            if (state.audioAnalyser) {
                // This implies a previous setup for the *current* state.audio exists.
                // This shouldn't happen if cleanupOldAudio worked correctly before setting up a new audio element.
                console.warn("setupAudioListeners: audioAnalyser already exists. Visualizer might be re-initialized or misbehaving.");
            }
             
            const source = state.audioContext.createMediaElementSource(state.audio);
            const analyser = state.audioContext.createAnalyser();
             
            source.connect(analyser);
            analyser.connect(state.audioContext.destination);
             
            // Configure analyzer
            analyser.fftSize = 256;
             
            // Store analyzer for visualization
            state.audioAnalyser = analyser; // Store the new analyser
            // console.log("setupAudioListeners: Audio visualizer setup complete.");
        } else {
            console.warn("setupAudioListeners: AudioContext not running. Visualizer not set up. State:", state.audioContext?.state);
            state.audioAnalyser = null;
        }
    } catch (e) {
        console.warn('setupAudioListeners: Web Audio API not supported or error during visualizer setup:', e);
        state.audioAnalyser = null; // Ensure it's null on error
    }
}

export async function processAudioFileAndUpdateState(file) {
    return new Promise((resolve, reject) => {
        cleanupOldAudio(); // Clean up previous audio instance and listeners

        const audioUrl = URL.createObjectURL(file);
        state.audio = new Audio(audioUrl); // Assign new audio object to state
        state.currentSong.audioUrl = audioUrl;
        state.currentSong.audioFilename = file.name;
        // state.isPlaying, state.currentTime, state.duration are reset by cleanupOldAudio

        // Temporary listeners for this specific loading process
        const tempOnLoadedMetadata = () => {
            state.audio.removeEventListener('loadedmetadata', tempOnLoadedMetadata);
            state.audio.removeEventListener('error', tempOnError);

            setupAudioListeners(); // Set up persistent listeners for the new audio
            
            const filename = file.name.replace(/\.[^/.]+$/, "");
            if (!state.currentSong.title && !state.currentSong.artist) {
                const parts = filename.split(' - ');
                if (parts.length > 1) {
                    state.currentSong.artist = parts[0].trim();
                    state.currentSong.title = parts.slice(1).join(' - ').trim();
                } else {
                    state.currentSong.title = filename.trim();
                }
            }

            Storage.saveCurrentSongState();
            UI.updateUI(); // Full UI update

            const audioReadyEvent = new CustomEvent('audioready', { detail: { audio: state.audio } });
            document.body.dispatchEvent(audioReadyEvent);
            resolve();
        };

        const tempOnError = (e) => {
            state.audio.removeEventListener('loadedmetadata', tempOnLoadedMetadata);
            state.audio.removeEventListener('error', tempOnError);

            console.error("Error loading audio:", e);
            URL.revokeObjectURL(audioUrl);
            state.currentSong.audioUrl = null; 
            state.audio = null; // Ensure state.audio is null on error
            UI.updateUI(); // Reflect that audio failed to load
            reject(new Error("Failed to load audio."));
        };
        
        state.audio.addEventListener('loadedmetadata', tempOnLoadedMetadata);
        state.audio.addEventListener('error', tempOnError);
    });
}

// Playlist management functions
import { state, resetCurrentSong, getCurrentPlaylist, getHistory } from './state.js';
import { elements } from './dom.js';
import * as UI from './ui/index.js';
import * as Storage from './storage.js';
import * as Modal from '../modal.js';
import * as AudioLocator from './audioLocator.js';
import * as Audio from '../audio.js'; // Import Audio module for cleanup

// Module-level variable to store song IDs for the playlist being edited in the modal
let tempEditingSongs = [];

// ...

export function loadSongFromHistory(index) {
    if (index < 0 || index >= state.history.length) return;
    
    const historySong = state.history[index];
    
    const previouslyLoadedSongId = state.currentSong.id;
    const previouslyLoadedAudioUrl = state.currentSong.audioUrl;
    const previouslyLoadedImage = state.currentSong.image;

    // Revoke old blob URLs if we are switching to a *different* song.
    if (previouslyLoadedSongId && previouslyLoadedSongId !== historySong.id) {
        // Audio blob URL is handled by Audio.cleanupOldAudio()
        if (previouslyLoadedImage && previouslyLoadedImage.startsWith('blob:')) {
            URL.revokeObjectURL(previouslyLoadedImage);
        }
    }
    
    // Update current song with history data
    state.currentSong = {
        // ...
        audioUrl: historySong.audioUrl || null, // Prefer audioUrl from history if available
        image: previouslyLoadedImage ? previouslyLoadedImage : (historySong.image || null),
        audioFilename: historySong.audioFilename || null,
        extractedPalette: previouslyLoadedSongId === historySong.id ? state.currentSong.extractedPalette : [],
    };

    // Manage audio state
    if (previouslyLoadedSongId !== historySong.id || !state.audio) { 
        Audio.cleanupOldAudio(); // Clean up any existing audio thoroughly

        if (state.currentSong.audioUrl) { // If the newly loaded song data has an audioUrl
            try {
                state.audio = new Audio(state.currentSong.audioUrl);
                Audio.setupAudioListeners(); // This will set up for the new state.audio
            } catch (e) {
                console.error(`Error creating audio from URL ${state.currentSong.audioUrl}:`, e);
                if (state.currentSong.audioUrl.startsWith('blob:')) URL.revokeObjectURL(state.currentSong.audioUrl);
                state.currentSong.audioUrl = null; 
            }
        }
    } else { // Same song re-selected. Reset its playback.
        if(state.audio) {
            state.audio.pause();
            state.audio.currentTime = 0; // Rewind it.
            state.isPlaying = false;
        } else {
            // This case (same song ID but state.audio is null) implies something went wrong.
            // Attempt cleanup and let AudioLocator try to find it.
            Audio.cleanupOldAudio();
        }
    }

    state.currentLineIndex = -1;
    
    // Audio location logic (runs if state.audio is null and audioFilename exists)
    if (!state.audio && state.currentSong.audioFilename) {
        AudioLocator.findAndLoadAudio(state.currentSong)
            .then(audioLoaded => {
                if (!audioLoaded) {
                    UI.updateUI();
                }
                Storage.saveCurrentSongState();
            })
            .catch(error => {
                console.error("Error in audio location process:", error);
                UI.updateUI(); // Update UI to reflect error or no audio state
                Storage.saveCurrentSongState();
            });
    } else {
        UI.updateUI(); // Update UI even if audio is already available or no locator needed
        Storage.saveCurrentSongState();
    }
}